{
	"compilerOptions": {
		"allowJs": true,
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"sourceMap": true,
		"strict": true,
		"target": "es2022",
		"noErrorTruncation": true,
		"paths": {
			"src/*": ["../src/*"],
			"tree/*": ["../src/tree/*"],
			"services/*": ["../src/services/*"],
			"commands/*": ["../src/commands/*"],
			"css/*": ["../src/css/*"],
			"fonts/*": ["../src/fonts/*"],
			"test/*": ["./*"]
		},
		"lib": ["esnext", "dom", "dom.iterable"],
		"types": ["mocha"]
	},
	"include": ["../src/**/*", "./**/*"],
	"exclude": ["../dist", "../node_modules"]
}
